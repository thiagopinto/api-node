# Configuração do Servidor
PORT=3000

# Configuração do Redis (compatível com os padrões de infraestrutura)
CORE_REDIS_HOST=127.0.0.1
CORE_REDIS_PORT=6379
CORE_REDIS_USER=
CORE_REDIS_PASSWORD=
CORE_REDIS_DB=0
CORE_REDIS_TLS=false
CORE_REDIS_TIMEOUT=5000
CORE_REDIS_CONNECT_TIMEOUT=10000

# Ou URL direta:
# REDIS_URL=redis://127.0.0.1:6379
